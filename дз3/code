import numpy as np
import matplotlib.pyplot as plt
from scipy.io import wavfile

rate, data = wavfile.read("audio.wav")

print("Частота дискретизации:", rate, "Гц")
print("Форма массива:", data.shape)
print("Тип данных:", data.dtype)

if np.issubdtype(data.dtype, np.integer):
    max_value = np.iinfo(data.dtype).max
    signal = data.astype(np.float64) / max_value
else:
    signal = data.astype(np.float64)

if signal.ndim == 2:
    signal_for_plot = signal.mean(axis=1)
else:
    signal_for_plot = signal

n = len(signal_for_plot)
time = np.arange(n) / rate

plt.figure(figsize=(12, 4))
plt.plot(time, signal_for_plot, linewidth=0.6)
plt.xlabel("Время, с")
plt.ylabel("Амплитуда")
plt.title("Исходный аудиосигнал")
plt.grid()
plt.tight_layout()
plt.savefig("01_original_signal.png", dpi=200)
plt.show()


show_time = 0.05
show_n = int(show_time * rate)

plt.figure(figsize=(12, 4))
plt.plot(time[:show_n], signal_for_plot[:show_n], linewidth=1)
plt.xlabel("Время, с")
plt.ylabel("Амплитуда")
plt.title("Увеличенный фрагмент исходного сигнала")
plt.grid()
plt.tight_layout()
plt.savefig("02_original_signal_zoom.png", dpi=200)
plt.show()

spectrum = np.fft.rfft(signal_for_plot)
freqs = np.fft.rfftfreq(n, d=1 / rate)

amplitudes = np.abs(spectrum)

plt.figure(figsize=(12, 4))
plt.plot(freqs, amplitudes, linewidth=0.8)
plt.xlim(0, min(10000, rate / 2))
plt.xlabel("Частота, Гц")
plt.ylabel("Амплитуда спектра")
plt.title("Спектр исходного аудиосигнала")
plt.grid()
plt.tight_layout()
plt.savefig("03_original_spectrum.png", dpi=200)
plt.show()

def filter_one_channel(channel, mask):
    spec = np.fft.rfft(channel)
    spec_filtered = spec * mask
    filtered_channel = np.fft.irfft(spec_filtered, n=len(channel))
    return filtered_channel


def apply_filter(audio, mask):
    if audio.ndim == 1:
        return filter_one_channel(audio, mask)

    filtered_channels = []

    for i in range(audio.shape[1]):
        filtered_channel = filter_one_channel(audio[:, i], mask)
        filtered_channels.append(filtered_channel)

    return np.column_stack(filtered_channels)


def save_wav(filename, audio):
    audio = np.clip(audio, -1, 1)
    audio_int16 = (audio * 32767).astype(np.int16)
    wavfile.write(filename, rate, audio_int16)

freqs_filter = np.fft.rfftfreq(signal.shape[0], d=1 / rate)
mask_low = freqs_filter <= 1500
mask_high = freqs_filter >= 1500
mask_band_pass = (freqs_filter >= 300) & (freqs_filter <= 3000)
mask_band_stop = ~((freqs_filter >= 300) & (freqs_filter <= 3000))
signal_low = apply_filter(signal, mask_low)
signal_high = apply_filter(signal, mask_high)
signal_band_pass = apply_filter(signal, mask_band_pass)
signal_band_stop = apply_filter(signal, mask_band_stop)

save_wav("low_pass_1500Hz.wav", signal_low)
save_wav("high_pass_1500Hz.wav", signal_high)
save_wav("band_pass_300_3000Hz.wav", signal_band_pass)
save_wav("band_stop_300_3000Hz.wav", signal_band_stop)

print("Файлы сохранены:")
print("low_pass_1500Hz.wav")
print("high_pass_1500Hz.wav")
print("band_pass_300_3000Hz.wav")
print("band_stop_300_3000Hz.wav")

def to_mono(audio):
    if audio.ndim == 2:
        return audio.mean(axis=1)
    return audio


signals_for_spectra = {
    "Исходный": to_mono(signal),
    "НЧ-фильтр до 1500 Гц": to_mono(signal_low),
    "ВЧ-фильтр от 1500 Гц": to_mono(signal_high),
    "Полосовой 300–3000 Гц": to_mono(signal_band_pass),
    "Режекторный 300–3000 Гц": to_mono(signal_band_stop),
}

plt.figure(figsize=(13, 7))

for label, sig in signals_for_spectra.items():
    spec = np.fft.rfft(sig)
    amp = np.abs(spec)
    plt.plot(freqs, amp, linewidth=0.8, label=label)

plt.xlim(0, min(8000, rate / 2))
plt.xlabel("Частота, Гц")
plt.ylabel("Амплитуда спектра")
plt.title("Сравнение спектров до и после фильтрации")
plt.grid()
plt.legend()
plt.tight_layout()
plt.savefig("04_spectra_comparison.png", dpi=200)
plt.show()
